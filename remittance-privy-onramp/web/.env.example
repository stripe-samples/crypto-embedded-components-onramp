VITE_STRIPE_PUBLISHABLE_KEY=pk_test_YOUR_PUBLISHABLE_KEY
VITE_API_URL=http://localhost:3001
VITE_ONRAMP_NETWORK=tempo

# Privy client configuration
VITE_PRIVY_APP_ID=YOUR_PRIVY_APP_ID
# Optional for React web. Set this only if you create a dedicated Privy web app client.
VITE_PRIVY_CLIENT_ID=

# Public IDs used when the user grants the backend delegated wallet authority.
# The matching authorization private key stays on the backend.
VITE_PRIVY_WALLET_SIGNER_ID=YOUR_PRIVY_KEY_QUORUM_ID
VITE_PRIVY_WALLET_POLICY_IDS=YOUR_OPTIONAL_POLICY_ID
