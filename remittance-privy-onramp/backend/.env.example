# Stripe secret key (sandbox or livemode)
STRIPE_SECRET_KEY=sk_test_YOUR_SECRET_KEY

# OAuth credentials provisioned by Stripe during onboarding
OAUTH_CLIENT_ID=YOUR_OAUTH_CLIENT_ID
OAUTH_CLIENT_SECRET=YOUR_OAUTH_CLIENT_SECRET

# Server port (optional, defaults to 3001)
PORT=3001

# PostgreSQL. The default matches backend/compose.yaml.
DATABASE_URL=postgresql://remittance:remittance@localhost:5432/remittance

# Privy server credentials for delegated transfer after Onramp fulfillment
PRIVY_APP_ID=YOUR_PRIVY_APP_ID
PRIVY_APP_SECRET=YOUR_PRIVY_APP_SECRET
PRIVY_APP_AUTHORIZATION_PRIVATE_KEY=YOUR_BASE64_PKCS8_AUTHORIZATION_PRIVATE_KEY
PRIVY_SPONSOR_GAS=true

# Chain config for the post-delivery delegated transfer step
# Base Sepolia: eip155:84532. Base mainnet: eip155:8453.
# Tempo testnet: eip155:42431. Tempo mainnet: eip155:4217.
REMITTANCE_ONRAMP_NETWORK=tempo
PRIVY_CAIP2=eip155:4217
USDC_CONTRACT_ADDRESS=0xYOUR_USDC_CONTRACT_ADDRESS
