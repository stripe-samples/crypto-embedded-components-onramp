HOST=0.0.0.0
PORT=3001
# Vercel trusts one proxy hop automatically. Set this for other hosting providers.
# TRUSTED_PROXY_HOPS=1

STRIPE_SK_TEST_KEY=sk_test_YOUR_SECRET_KEY
STRIPE_PK_TEST_KEY=pk_test_YOUR_PUBLISHABLE_KEY

# Set both live-mode keys to enable live mode.
STRIPE_SK_LIVE_KEY=
STRIPE_PK_LIVE_KEY=

OAUTH_CLIENT_ID=YOUR_OAUTH_CLIENT_ID
OAUTH_CLIENT_SECRET=YOUR_OAUTH_CLIENT_SECRET
# Add auth.persist_login:read only when Stripe has enabled seamless sign-in.
OAUTH_SCOPES=crypto:ramp,kyc.status:read

# Use at least 32 characters of cryptographically random secret material.
JWT_SIGNING_SECRET=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS_LONG
